rules_version = '2';

// ============================================================================
// EnerJeep Firestore security rules
//
// The security model:
//   - Every request must come from a signed-in Firebase Auth user whose
//     phone number belongs to a real account in /users (isMember).
//   - "superadmin" manages all queues; station admins manage only their assigned terminal.
//   - "drivers" read the shared operational data (queue, incidents) and
//     their own earnings (kita, ledger), and edit only their own profile.
//   - Credentials live in /userSecrets and are ONLY readable by their
//     owner. No rule ever exposes a password hash to anyone else, and no
//     rule accepts a plaintext `password` field.
//
// Deploy with:  firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authPhone() {
      return request.auth.token.phone_number;
    }

    // A phone-authenticated session is not enough by itself. The trusted
    // completeSecureLogin callable creates this server-only record after
    // verifying the password as well as Firebase Phone Authentication.
    function hasSecureSession() {
      return signedIn()
        && request.auth.token.auth_time is int
        && exists(/databases/$(database)/documents/secureSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/secureSessions/$(request.auth.uid)).data.phoneNumber == authPhone()
        && get(/databases/$(database)/documents/secureSessions/$(request.auth.uid)).data.authTime == request.auth.token.auth_time
        && get(/databases/$(database)/documents/secureSessions/$(request.auth.uid)).data.expiresAt is timestamp
        && get(/databases/$(database)/documents/secureSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }

    function ownAccountIsActive() {
      return signedIn() && authPhone() != null
        && exists(/databases/$(database)/documents/users/$(authPhone()))
        && get(/databases/$(database)/documents/users/$(authPhone())).data.get('status', 'active') == 'active';
    }

    // The role of the signed-in user, read directly from their own document.
    function ownRole() {
      return signedIn() && authPhone() != null
        && exists(/databases/$(database)/documents/users/$(authPhone()))
        ? get(/databases/$(database)/documents/users/$(authPhone())).data.role
        : null;
    }

    function isMember() {
      return hasSecureSession() && ownAccountIsActive()
        && ownRole() in ['superadmin', 'admin', 'driver'];
    }

    function isAdmin() {
      return isMember() && ownRole() in ['admin', 'superadmin'];
    }

    function isSuperadmin() {
      return isMember() && ownRole() == 'superadmin';
    }

    function isOwner(phone) {
      return signedIn() && authPhone() == phone;
    }

    // Passwords are never stored on the profile document.
    //
    // CREATE: the new document must not carry a password field at all.
    function hasNoPasswordField() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    // UPDATE: documents that still carry a LEGACY plaintext password
    // field must remain editable (deactivate, profile edits), and the
    // one-time migration that DELETES that field must always pass.
    // Only writes that add or change a password value are rejected.
    function doesNotSetPassword() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['password'])
             || !request.resource.data.keys().hasAny(['password']);
    }

    // ------------------------------------------------------------------
    // /users - profiles (no credentials ever live here)
    // ------------------------------------------------------------------
    match /users/{phone} {
      // A phone-verified user may read only their own profile during login
      // or password recovery. All other account reads require a secure session.
      allow get: if (signedIn() && isOwner(phone)) || isAdmin();

      // Account management lists every account (admin) or looks up
      // drivers (admin screens). Drivers never list this collection.
      allow list: if isAdmin();

      // An admin creates accounts. A first-login "self-create" migration
      // branch used to live here - it was unreachable (isMember() already
      // requires an existing users document) and it did not restrict the
      // role field, so it is intentionally gone: only admins create
      // accounts.
      //
      // User levels: only a superadmin may create an ADMIN account. An
      // admin may create driver accounts only (the app enforces this
      // too - here it is the safety net).
      allow create: if isAdmin()
        && hasNoPasswordField()
        && request.resource.data.keys().hasOnly([
             'userId', 'firstName', 'lastName', 'phoneNumber', 'role',
             'status', 'createdAt', 'licenseNumber', 'plateNumber',
             'seater', 'emergencyContactName', 'emergencyContactNumber',
             'emergencyContact', 'isVehicleActive', 'adminStation'
           ])
        && request.resource.data.userId is string
        && request.resource.data.phoneNumber == phone
        && request.resource.data.role in ['admin', 'driver']
        && request.resource.data.status == 'active'
        && (isSuperadmin() || request.resource.data.role == 'driver');

      // Account-state changes are restricted to explicit mutable fields.
      allow update: if (
          isAdmin()
          && doesNotSetPassword()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'isVehicleActive', 'updatedAt'])
          && (isSuperadmin() || resource.data.role == 'driver')
        )
        || (
          isSuperadmin()
          && doesNotSetPassword()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'updatedAt'])
          && request.resource.data.role in ['admin', 'driver', 'superadmin']
        )
        || (
          isMember()
          && isOwner(phone)
          && doesNotSetPassword()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'firstName', 'lastName',
                 'emergencyContactName', 'emergencyContactNumber',
                 'emergencyContact', 'fcmToken', 'updatedAt'
               ])
        )
        );

      // Each member can read only their own server-created notifications.
      match /notifications/{notificationId} {
        allow read: if isMember() && isOwner(phone);
        allow update: if isMember()
          && isOwner(phone)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read', 'readAt'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }

      // Account removal must pass through the trusted deleteAccount callable.
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // /userSecrets - salted password hashes, owner-only reads
    // ------------------------------------------------------------------
    match /userSecrets/{phone} {
      // Password hashes are never readable by Android clients. Login,
      // password change, and password reset use trusted Cloud Functions.
      allow get, list: if false;

      // Account creation is the only client-side secret CREATE. It must be
      // in the same atomic batch/transaction as a brand-new account profile.
      // Existing password documents can never be overwritten by a client.
      function createsMatchingNewAccount() {
        return !exists(/databases/$(database)/documents/users/$(phone))
          && existsAfter(/databases/$(database)/documents/users/$(phone))
          && getAfter(/databases/$(database)/documents/users/$(phone)).data.phoneNumber == phone
          && getAfter(/databases/$(database)/documents/users/$(phone)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/users/$(phone)).data.role in ['admin', 'driver'];
      }

      function validSecret() {
        return request.resource.data.keys().hasOnly([
                 'passwordHash', 'passwordSalt', 'iterations',
                 'createdAt', 'updatedAt'
               ])
               && request.resource.data.keys().hasAll([
                 'passwordHash', 'passwordSalt', 'iterations'
               ])
               && request.resource.data.passwordHash is string
               && request.resource.data.passwordHash.matches('^[0-9a-fA-F]{64}$')
               && request.resource.data.passwordSalt is string
               && request.resource.data.passwordSalt.matches('^[0-9a-fA-F]{32}$')
               && request.resource.data.iterations is int
               && request.resource.data.iterations == 210000;
      }

      allow create: if isAdmin() && createsMatchingNewAccount() && validSecret();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // /driverPlateClaims - normalized unique plate ownership.
    // Only administrators can read or maintain these transactional claims.
    // ------------------------------------------------------------------
    match /driverPlateClaims/{normalizedPlate} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // /queue - everyone can view both terminals; local administrators
    // can only change queue entries belonging to their assigned station.
    // ------------------------------------------------------------------
    function ownAdminStation() {
      return signedIn() && authPhone() != null
        ? get(/databases/$(database)/documents/users/$(authPhone())).data.get('adminStation', '')
        : '';
    }

    function queueRouteStation(route) {
      return route is string && route.matches('(?i)^marilao.*') ? 'marilao'
        : route is string && route.matches('(?i)^monumento.*') ? 'monumento'
        : null;
    }

    function canManageQueueRoute(route) {
      return (
        (isSuperadmin() && ownAccountIsActive())
        || (
          ownRole() == 'admin'
          && isMember()
          && ownAccountIsActive()
          && queueRouteStation(route) != null
          && ownAdminStation() == queueRouteStation(route)
        ));
    }

    match /queue/{entryId} {
      allow read: if isMember();
      // Clients may add only a fresh waiting entry. Dispatch/completion and
      // other lifecycle transitions are performed by trusted Cloud Functions.
      allow create: if canManageQueueRoute(request.resource.data.route)
        && request.resource.data.keys().hasOnly([
          'id', 'driverId', 'plateNumber', 'driverName', 'route',
          'position', 'status', 'time', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.driverId is string
        && request.resource.data.driverId.size() > 0
        && request.resource.data.status == 'Nakapila'
        && request.resource.data.position is int
        && request.resource.data.position > 0;
      // Direct client writes are limited to reordering and cancellation.
      // Dispatch and travel completion must use atomic trusted transactions.
      allow update: if (
        canManageQueueRoute(resource.data.route)
        && queueRouteStation(request.resource.data.route)
             == queueRouteStation(resource.data.route)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['position', 'isCancelled', 'cancelledAt', 'updatedAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['position'])
          || (request.resource.data.position is int && request.resource.data.position > 0)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isCancelled'])
          || request.resource.data.isCancelled is bool
        )
      ) || (
        // One-time legacy cleanup only: Superadmin may assign a route to
        // an entry whose route is missing/blank, without changing its identity or status.
        isSuperadmin()
        && (
          resource.data.get('route', '') == ''
          || resource.data.get('route', '') == null
        )
        && request.resource.data.route is string
        && queueRouteStation(request.resource.data.route) != null
        && request.resource.data.position is int
        && request.resource.data.position > 0
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['route', 'position', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['route'])
      );
      // Deletions are handled by the account/queue cleanup Cloud Functions.
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // /settings - app settings (queue rotation cutoff, deduction tiers)
    //
    // Ang cut-off hour ay SUPERADMIN lang ang maaaring magbago. Ang
    // admin ay pinapayagang i-maintain ang ibang fields (hal. ang
    // lastQueueDay/routesNormalized na isinusulat ng auto-reset engine
    // kahit naka-login lang ang admin) - basta hindi cutoffHour.
    // ------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if isMember();

      // A station admin only needs to advance the shared queue revision
      // for actions on their own route. Rotation metadata is global.
      allow create: if (isSuperadmin() && ownAccountIsActive())
        || (
          isAdmin()
          && ownAccountIsActive()
          && docId == 'queueControl'
          && request.resource.data.keys().hasOnly(['revision', 'updatedAt'])
          && request.resource.data.revision is int
          && request.resource.data.revision == 1
        );

      allow update: if (isSuperadmin() && ownAccountIsActive())
        || (
          isAdmin()
          && ownAccountIsActive()
          && docId == 'queueControl'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['revision', 'updatedAt'])
          && request.resource.data.revision is int
          && request.resource.data.revision == resource.data.revision + 1
        );

      allow delete: if isSuperadmin() && ownAccountIsActive();
    }

    // ------------------------------------------------------------------
    // /activityLogs - audit log (accountability)
    //
    // EVERY admin action is recorded here (dispatch, cancel, create
    // account, donations, ...) pati ang "Tapos Na Bumyahe" ng driver.
    // Only the SUPERADMIN can read the log - auditing the admins is the
    // oversight power of the level above. Entries can never be edited
    // or deleted, so the trail is honest.
    //
    // Ang bawat entry ay may actorPhone - laging ang phone number ng
    // SARILING nagsulat. Hindi na mapapanggap ng sinuman ang audit
    // trail sa pangalan ng iba.
    // ------------------------------------------------------------------
    match /activityLogs/{logId} {
      allow read: if isSuperadmin();
      allow create: if isMember()
        && request.resource.data.actorPhone == authPhone();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // /emergencyContacts - the "available admin" emergency list
    //
    // Only the SUPERADMIN manages this list (add/edit/remove). Every
    // member can read it - the drivers use it to call for help.
    // ------------------------------------------------------------------
    match /emergencyContacts/{contactId} {
      allow read: if isMember();
      allow create, update, delete: if isSuperadmin();
    }

    // ------------------------------------------------------------------
    // /incidents - admins manage; drivers read only explicitly shared reports
    // ------------------------------------------------------------------
    match /incidents/{incidentId} {
      allow read: if isAdmin()
                  || (isMember() && resource.data.sentToDriver == true);
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // /ledger - earnings and fees (drivers read their data, admins write)
    //
    // Drivers query only by their own users.userId. Plate numbers are
    // display identifiers and may be reused, so they never grant access.
    // ------------------------------------------------------------------
    match /ledger/{entryId} {
      // Driver access is identity-based only. Plates can be reused.
      allow read: if isAdmin()
                  || (isMember() && resource.data.driverId ==
                       get(/databases/$(database)/documents/users/$(authPhone())).data.userId);
      // Dispatch and manual collection records are created by trusted callables only.
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // /kita - RETIRED (2026-10-31): ang kita ng driver ay galing na sa
    // /ledger (dispatch records) lamang. Ang koleksyong ito ay nananatili
    // lang bilang backstop para sa mga lumang dokumento - basa lang ang
    // driver, at WALANG SINUMAN ang makakagawa o makakabago dito.
    // ------------------------------------------------------------------
    match /kita/{entryId} {
      allow read: if isAdmin()
                  || (isMember() && resource.data.driverId ==
                       get(/databases/$(database)/documents/users/$(authPhone())).data.userId);
      // RETIRED: earnings are read from /ledger. Keep this collection
      // read-only so it cannot become a second source of truth.
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // /donations - donations report
    //
    // Ang donasyon (at ang "gamit" nito) ay pondo ng kooperatiba -
    // SUPERADMIN lang ang humahawak. Ang donasyon ay HIWALAY sa kita
    // ng mga driver - hindi ito binabawas sa kahit kanino.
    // ------------------------------------------------------------------
    match /donations/{donationId} {
      allow read: if isMember();
      allow create, update, delete: if isSuperadmin();
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
