rules_version = '2';

// ============================================================================
// EnerJeep Firestore security rules
//
// The security model:
//   - Every request must come from a signed-in Firebase Auth user whose
//     phone number belongs to a real account in /users (isMember).
//   - "admins" manage accounts, the queue, ledger, incidents and reports.
//   - "drivers" read the shared operational data (queue, incidents) and
//     their own earnings (kita, ledger), and edit only their own profile.
//   - Credentials live in /userSecrets and are ONLY readable by their
//     owner. No rule ever exposes a password hash to anyone else, and no
//     rule accepts a plaintext `password` field.
//
// Deploy with:  firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authPhone() {
      return request.auth.token.phone_number;
    }

    // The role of the signed-in user, read directly from their own
    // document. `get()` inside rules is not limited by the target
    // document's own rules, so this works even for private documents.
    function ownRole() {
      return signedIn() && authPhone() != null
        ? get(/databases/$(database)/documents/users/$(authPhone())).data.role
        : null;
    }

    function isMember() {
      return ownRole() in ['superadmin', 'admin', 'driver'];
    }

    function isAdmin() {
      return ownRole() in ['admin', 'superadmin'];
    }

    function isSuperadmin() {
      return ownRole() == 'superadmin';
    }

    function isOwner(phone) {
      return signedIn() && authPhone() == phone;
    }

    // Passwords are never stored on the profile document.
    //
    // CREATE: the new document must not carry a password field at all.
    function hasNoPasswordField() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    // UPDATE: documents that still carry a LEGACY plaintext password
    // field must remain editable (deactivate, profile edits), and the
    // one-time migration that DELETES that field must always pass.
    // Only writes that add or change a password value are rejected.
    function doesNotSetPassword() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['password'])
             || !request.resource.data.keys().hasAny(['password']);
    }

    // ------------------------------------------------------------------
    // /users - profiles (no credentials ever live here)
    // ------------------------------------------------------------------
    match /users/{phone} {
      allow get: if isAdmin() || (isMember() && isOwner(phone));

      // Account management lists every account (admin) or looks up
      // drivers (admin screens). Drivers never list this collection.
      allow list: if isAdmin();

      // An admin creates accounts. A first-login "self-create" migration
      // branch used to live here - it was unreachable (isMember() already
      // requires an existing users document) and it did not restrict the
      // role field, so it is intentionally gone: only admins create
      // accounts.
      //
      // User levels: only a superadmin may create an ADMIN account. An
      // admin may create driver accounts only (the app enforces this
      // too - here it is the safety net).
      allow create: if isAdmin()
        && hasNoPasswordField()
        && request.resource.data.keys().hasOnly([
             'userId', 'firstName', 'lastName', 'phoneNumber', 'role',
             'status', 'createdAt', 'licenseNumber', 'plateNumber',
             'seater', 'emergencyContactName', 'emergencyContactNumber',
             'emergencyContact', 'isVehicleActive', 'adminStation'
           ])
        && request.resource.data.userId is string
        && request.resource.data.phoneNumber == phone
        && request.resource.data.role in ['admin', 'driver']
        && request.resource.data.status == 'active'
        && (isSuperadmin() || request.resource.data.role == 'driver');

      // Account-state changes are restricted to explicit mutable fields.
      allow update: if (
          isAdmin()
          && doesNotSetPassword()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'isVehicleActive', 'updatedAt'])
          && (isSuperadmin() || resource.data.role == 'driver')
        )
        || (
          isSuperadmin()
          && doesNotSetPassword()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'updatedAt'])
          && request.resource.data.role in ['admin', 'driver', 'superadmin']
        )
        || (
          isMember()
          && isOwner(phone)
          && doesNotSetPassword()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'firstName', 'lastName',
                 'emergencyContactName', 'emergencyContactNumber',
                 'emergencyContact', 'fcmToken', 'updatedAt', 'password'
               ])
        );

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // /userSecrets - salted password hashes, owner-only reads
    // ------------------------------------------------------------------
    match /userSecrets/{phone} {
      // Password verification occurs only after Firebase Phone Auth has
      // established the matching phone-number session. The client never
      // receives password hashes before OTP verification.
      allow get: if isOwner(phone);
      allow list: if false;

      // The owner sets their own secret (register / change / reset) and
      // an admin sets it once when creating the account.
      function validSecret() {
        return request.resource.data.keys().hasOnly([
                 'passwordHash', 'passwordSalt', 'iterations',
                 'createdAt', 'updatedAt'
               ])
               && request.resource.data.keys().hasAll([
                 'passwordHash', 'passwordSalt', 'iterations'
               ])
               && request.resource.data.passwordHash is string
               && request.resource.data.passwordHash.size() > 0
               && request.resource.data.passwordSalt is string
               && request.resource.data.passwordSalt.size() > 0
               && request.resource.data.iterations is int
               && request.resource.data.iterations > 0;
      }

      allow create: if validSecret() && (isOwner(phone) || isAdmin());
      allow update: if validSecret() && isOwner(phone);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // /queue - dispatch queue (drivers read, admins manage)
    // ------------------------------------------------------------------
    match /queue/{entryId} {
      allow read: if isMember();
      allow create, delete: if isAdmin();

      // Temporary fallback while finishDriverTravel is not deployed:
      // a driver may update ONLY their own queue document, and ONLY to mark
      // it completed. No other driver's entry or queue order can be changed.
      function driverOwnsThisQueueEntry() {
        return signedIn()
          && authPhone() != null
          && exists(/databases/$(database)/documents/users/$(authPhone()))
          && get(/databases/$(database)/documents/users/$(authPhone())).data.role == 'driver'
          && get(/databases/$(database)/documents/users/$(authPhone())).data.userId == resource.data.driverId;
      }

      function completesOwnQueueEntry() {
        return driverOwnsThisQueueEntry()
          && resource.data.status != 'dispatched'
          && resource.data.status != 'completed'
          && resource.data.status != 'cancelled'
          && resource.data.status != 'resolved'
          && resource.data.isCancelled != true
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'endTravelAt', 'updatedAt', 'position'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasAll(['status', 'endTravelAt', 'updatedAt', 'position'])
          && request.resource.data.status == 'completed'
          && request.resource.data.position == 0
          && request.resource.data.endTravelAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      // All other queue changes remain administrator-only.
      allow update: if isAdmin() || completesOwnQueueEntry();
    }

    // ------------------------------------------------------------------
    // /settings - app settings (queue rotation cutoff, deduction tiers)
    //
    // Ang cut-off hour ay SUPERADMIN lang ang maaaring magbago. Ang
    // admin ay pinapayagang i-maintain ang ibang fields (hal. ang
    // lastQueueDay/routesNormalized na isinusulat ng auto-reset engine
    // kahit naka-login lang ang admin) - basta hindi cutoffHour.
    // ------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if isMember();

      allow create: if isSuperadmin()
        || (isAdmin()
            && !request.resource.data.keys().hasAny(['cutoffHour']));

      allow update: if isSuperadmin()
        || (isAdmin()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['cutoffHour']));

      allow delete: if isSuperadmin();
    }

    // ------------------------------------------------------------------
    // /activityLogs - audit log (accountability)
    //
    // EVERY admin action is recorded here (dispatch, cancel, create
    // account, donations, ...) pati ang "Tapos Na Bumyahe" ng driver.
    // Only the SUPERADMIN can read the log - auditing the admins is the
    // oversight power of the level above. Entries can never be edited
    // or deleted, so the trail is honest.
    //
    // Ang bawat entry ay may actorPhone - laging ang phone number ng
    // SARILING nagsulat. Hindi na mapapanggap ng sinuman ang audit
    // trail sa pangalan ng iba.
    // ------------------------------------------------------------------
    match /activityLogs/{logId} {
      allow read: if isSuperadmin();
      allow create: if isMember()
        && request.resource.data.actorPhone == authPhone();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // /emergencyContacts - the "available admin" emergency list
    //
    // Only the SUPERADMIN manages this list (add/edit/remove). Every
    // member can read it - the drivers use it to call for help.
    // ------------------------------------------------------------------
    match /emergencyContacts/{contactId} {
      allow read: if isMember();
      allow create, update, delete: if isSuperadmin();
    }

    // ------------------------------------------------------------------
    // /incidents - everyone reads, admins record and resolve
    // ------------------------------------------------------------------
    match /incidents/{incidentId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // /ledger - earnings and fees (drivers read their data, admins write)
    //
    // Drivers query only by their own users.userId. Plate numbers are
    // display identifiers and may be reused, so they never grant access.
    // ------------------------------------------------------------------
    match /ledger/{entryId} {
      // Driver access is identity-based only. Plates can be reused.
      allow read: if isAdmin()
                  || (isMember() && resource.data.driverId ==
                       get(/databases/$(database)/documents/users/$(authPhone())).data.userId);
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // /kita - RETIRED (2026-10-31): ang kita ng driver ay galing na sa
    // /ledger (dispatch records) lamang. Ang koleksyong ito ay nananatili
    // lang bilang backstop para sa mga lumang dokumento - basa lang ang
    // driver, at WALANG SINUMAN ang makakagawa o makakabago dito.
    // ------------------------------------------------------------------
    match /kita/{entryId} {
      allow read: if isAdmin()
                  || (isMember() && resource.data.driverId ==
                       get(/databases/$(database)/documents/users/$(authPhone())).data.userId);
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // /donations - donations report
    //
    // Ang donasyon (at ang "gamit" nito) ay pondo ng kooperatiba -
    // SUPERADMIN lang ang humahawak. Ang donasyon ay HIWALAY sa kita
    // ng mga driver - hindi ito binabawas sa kahit kanino.
    // ------------------------------------------------------------------
    match /donations/{donationId} {
      allow read: if isMember();
      allow create, update, delete: if isSuperadmin();
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
